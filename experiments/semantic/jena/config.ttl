@prefix :       <#> .
@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix ja:     <http://jena.hpl.hp.com/2005/11/Assembler#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<#service> rdf:type fuseki:Service ;
    fuseki:name "movies" ;
    fuseki:endpoint [ fuseki:operation fuseki:query ; fuseki:name "sparql" ] ;
    fuseki:dataset <#dataset> .

<#dataset> rdf:type ja:RDFDataset ;
    ja:defaultGraph <#inferenceModel> .

<#inferenceModel> rdf:type ja:InfModel ;
    ja:baseModel <#baseModel> ;
    ja:reasoner <#reasoner> .

<#reasoner> rdf:type ja:GenericRuleReasoner ;
    ja:rulesFrom <file:///input/movie.rules> ;
    ja:ruleMode "forward" .

<#baseModel> rdf:type ja:MemoryModel ;
    ja:content [ ja:externalContent <file:///input/movie_ontology.ttl> ] ;
    ja:content [ ja:externalContent <file:///input/movies.ttl> ] .
