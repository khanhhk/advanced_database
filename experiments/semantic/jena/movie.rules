@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix owl:  <http://www.w3.org/2002/07/owl#>.

[domain:    (?p rdfs:domain ?class) (?subject ?p ?object) -> (?subject rdf:type ?class)]
[range:     (?p rdfs:range ?class) (?subject ?p ?object) -> (?object rdf:type ?class)]
[inverse-a: (?p owl:inverseOf ?inverse) (?subject ?p ?object) -> (?object ?inverse ?subject)]
[inverse-b: (?p owl:inverseOf ?inverse) (?object ?inverse ?subject) -> (?subject ?p ?object)]
[symmetric: (?p rdf:type owl:SymmetricProperty) (?subject ?p ?object) -> (?object ?p ?subject)]
