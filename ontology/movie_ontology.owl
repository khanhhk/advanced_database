<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/movie-kg/" xml:base="https://example.org/movie-kg/"
 xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
 xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
 <owl:Ontology rdf:about="https://example.org/movie-kg/"><owl:versionInfo>1.1.0</owl:versionInfo></owl:Ontology>
 <owl:Class rdf:about="Movie"><owl:disjointWith rdf:resource="Person"/><owl:disjointWith rdf:resource="Genre"/><owl:disjointWith rdf:resource="Keyword"/><owl:disjointWith rdf:resource="Studio"/></owl:Class>
 <owl:Class rdf:about="Person"><owl:disjointWith rdf:resource="Genre"/><owl:disjointWith rdf:resource="Keyword"/><owl:disjointWith rdf:resource="Studio"/></owl:Class>
 <owl:Class rdf:about="Genre"><owl:disjointWith rdf:resource="Keyword"/><owl:disjointWith rdf:resource="Studio"/></owl:Class>
 <owl:Class rdf:about="Keyword"><owl:disjointWith rdf:resource="Studio"/></owl:Class><owl:Class rdf:about="Studio"/>
 <owl:ObjectProperty rdf:about="actedIn"><rdfs:domain rdf:resource="Person"/><rdfs:range rdf:resource="Movie"/><owl:inverseOf rdf:resource="hasActor"/></owl:ObjectProperty>
 <owl:ObjectProperty rdf:about="hasActor"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="Person"/></owl:ObjectProperty>
 <owl:ObjectProperty rdf:about="directed"><rdfs:domain rdf:resource="Person"/><rdfs:range rdf:resource="Movie"/><owl:inverseOf rdf:resource="directedBy"/></owl:ObjectProperty>
 <owl:ObjectProperty rdf:about="directedBy"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="Person"/></owl:ObjectProperty>
 <owl:ObjectProperty rdf:about="hasGenre"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="Genre"/></owl:ObjectProperty>
 <owl:ObjectProperty rdf:about="hasKeyword"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="Keyword"/></owl:ObjectProperty>
 <owl:ObjectProperty rdf:about="producedBy"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="Studio"/></owl:ObjectProperty>
 <owl:ObjectProperty rdf:about="coStarredWith"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/><rdfs:domain rdf:resource="Person"/><rdfs:range rdf:resource="Person"/></owl:ObjectProperty>
 <owl:DatatypeProperty rdf:about="title"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
 <owl:DatatypeProperty rdf:about="rating"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
 <owl:DatatypeProperty rdf:about="imdbRating"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/></owl:DatatypeProperty>
 <owl:DatatypeProperty rdf:about="imdbVotes"><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
 <owl:DatatypeProperty rdf:about="tmdbId"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/></owl:DatatypeProperty>
 <owl:DatatypeProperty rdf:about="imdbId"><rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/><rdfs:domain rdf:resource="Movie"/><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
 <owl:DatatypeProperty rdf:about="name"><rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/></owl:DatatypeProperty>
</rdf:RDF>
